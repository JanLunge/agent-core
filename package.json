{
  "name": "agent-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-core": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "pnpm run build:dashboard && tsup",
    "build:dashboard": "cd src/dashboard && npx vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@types/react": "^19.2.14",
    "age-encryption": "^0.3.0",
    "better-sqlite3": "^11.8.0",
    "chokidar": "^4.0.0",
    "commander": "^13.1.0",
    "fastify": "^5.8.4",
    "grammy": "^1.35.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "micromatch": "^4.0.8",
    "openai": "^4.85.0",
    "react": "^19.2.4",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.20.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
